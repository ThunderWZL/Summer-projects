# 数据库配置（默认使用 backend 工作目录下的 SQLite 文件）
DATABASE_URL=sqlite:///./siteppe.db
DATABASE_ECHO=false

# VLM 复核模型配置（真实密钥只放在本地 .env，禁止提交仓库）
# 默认 provider=fixed 时无需任何密钥即可运行测试与演示。
# 真实模型使用 provider=openai_compat，并填写兼容接口的 Base URL、密钥和模型 ID。
VLM_PROVIDER=fixed
VLM_API_BASE_URL=
VLM_API_KEY=
VLM_MODEL=fixed-reviewer
VLM_TIMEOUT_SECONDS=90
VLM_MAX_FRAMES=8
VLM_MAX_IMAGE_EDGE=1280
VLM_MAX_OUTPUT_TOKENS=512
VLM_MAX_RETRIES=2
VLM_RETRY_DELAY_SECONDS=0.5

# Agent 调查模型配置（配置密钥时需要安装 backend[ai]）
DEEPSEEK_API_KEY=
AGENT_LLM_MODEL=deepseek-v4-flash
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_TOOL_ROUNDS=6
AGENT_LLM_TEMPERATURE=0

# 权威依据 RAG（真实密钥只放在本地 .env，禁止提交仓库）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=chroma_db
OFFLINE_RAG_PATH=.data/requirements-rag-offline.json
RAG_TOP_K=5

# 视觉分析（默认 fixture 保持无模型环境可启动；真实模式需安装 backend[vision]）
VISION_PROVIDER=fixture
YOLO_WEIGHTS_PATH=
VISION_DEVICE=auto
VISION_TARGET_FPS=5
VISION_CONFIDENCE=0.25
VISION_IMAGE_SIZE=640
VISION_TRACKER=bytetrack.yaml
VISION_MODEL_NAME=yolo11n-ppe
VISION_MODEL_VERSION=w02
VISION_EVIDENCE_ROOT=.data/evidence
VISION_MINIMUM_PERSON_HEIGHT_PX=120
VISION_BOUNDARY_MARGIN_PX=5
VISION_MAXIMUM_PERSON_OVERLAP_IOU=0.5
VISION_MINIMUM_TRACK_OBSERVATIONS=3
VISION_MINIMUM_VALID_OBSERVATIONS=3
VISION_MAXIMUM_OBSERVATION_GAP_MS=500
VISION_MINIMUM_NEGATIVE_OBSERVATIONS=3
